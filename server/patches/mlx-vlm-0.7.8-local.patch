 METRICS_RECENT_LIMIT = 32
 
+# Live decode speed for in-flight requests (exposed as "live" in /v1/metrics).
+# Updated once per emitted token chunk; rate is measured over a short sliding window.
+LIVE_DECODE_WINDOW_S = 2.0
+LIVE_DECODE_STALE_S = 10.0
+_live_decode: dict = {}
+_live_decode_lock = Lock()
 
+
+def _live_decode_update(request_id, generated_tokens: int, now: float, finished: bool) -> None:
+    with _live_decode_lock:
+        if finished:
+            _live_decode.pop(request_id, None)
+            return
+        entry = _live_decode.get(request_id)
+        if entry is None:
+            entry = {"samples": deque(), "started_at": now}
+            _live_decode[request_id] = entry
+        samples = entry["samples"]
+        samples.append((now, generated_tokens))
+        while len(samples) > 2 and now - samples[0][0] > LIVE_DECODE_WINDOW_S:
+            samples.popleft()
+        entry["generated_tokens"] = generated_tokens
+        entry["updated_at"] = now
+
+
+def live_decode_snapshot() -> dict:
+    now = time.perf_counter()
+    requests = []
+    with _live_decode_lock:
+        for request_id in list(_live_decode):
+            entry = _live_decode[request_id]
+            if now - entry["updated_at"] > LIVE_DECODE_STALE_S:
+                del _live_decode[request_id]
+                continue
+            samples = entry["samples"]
+            (t0, n0), (t1, n1) = samples[0], samples[-1]
+            rate = (n1 - n0) / (t1 - t0) if t1 > t0 else 0.0
+            requests.append(
+                {
+                    "request_id": str(request_id),
+                    "generated_tokens": entry["generated_tokens"],
+                    "decode_tok_s": round(rate, 2),
+                }
+            )
+    return {
+        "in_flight_decoding": len(requests),
+        "decode_tok_s": round(sum(r["decode_tok_s"] for r in requests), 2),
+        "requests": requests,
+    }
+
